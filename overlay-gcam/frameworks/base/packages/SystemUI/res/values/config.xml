<?xml version="1.0" encoding="utf-8"?>
<!--
    SystemUI overlay, only with Google Camera in the build.
-->
<resources>
    <!-- The double press of power and the lockscreen camera shortcut open
         STILL_IMAGE_CAMERA(_SECURE) restricted to this package
         (SystemUI CameraIntents.getOverrideCameraPackage). Without it the
         intent resolves to both Google Camera and Aperture and the system
         asks which. Other applications' IMAGE_CAPTURE requests still offer
         both. -->
    <string name="config_cameraGesturePackage" translatable="false">com.android.MGC_8_9_097</string>
</resources>
