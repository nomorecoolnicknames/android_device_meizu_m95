//
// Device copy of hardware/lineage/interfaces/biometrics/fingerprint/2.0 for
// the Goodix blob:
//   1. BiometricsFingerprint.h declares the real 272-byte device structure
//      with the four Goodix vendor methods.
//   2. service.cpp starts a framework binder threadpool for the daemon's
//      callbacks on /dev/binder.
//   3. enumerate() does not call the blob's NULL slot.
// The module name has a .m95 suffix to avoid colliding with the upstream
// module; the service name (vendor.fps_hal) and HIDL instance are unchanged.
cc_binary {
    name: "android.hardware.biometrics.fingerprint@2.0-service.m95",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint@2.0-service.m95.rc"],
    srcs: [
        "service.cpp",
        "BiometricsFingerprint.cpp",
    ],
    shared_libs: [
        "libutils",
        "liblog",
        "libhidlbase",
        "libhardware",
        // Framework binder: the Goodix module and its daemon talk over
        // /dev/binder, and this process has to serve that node itself.
        "libbinder",
        "android.hardware.biometrics.fingerprint@2.1",
    ],
    proprietary: true,
}
