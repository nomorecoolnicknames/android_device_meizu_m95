# MTK picture quality daemon (/vendor/bin/pq), started when persist.m95.pq.enable
# is set (init.mt6797.rc).

type pq, domain;
type pq_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(pq)

# /dev/mtk_disp_mgr (graphics_device)
allow pq graphics_device:chr_file rw_file_perms;

# Binder service "PQ" (IPQService), looked up by the camera provider.
binder_use(pq)
binder_service(pq)

allow pq pq_service:service_manager add;

# Clients: camera provider, SurfaceFlinger and system apps (display tuning).
allow hal_camera_default pq_service:service_manager find;
allow surfaceflinger pq_service:service_manager find;
allow system_app pq_service:service_manager find;
allow platform_app pq_service:service_manager find;

# The MTK codec looks PQ up on vndbinder.
vndbinder_use(pq)
add_service(pq, pq_vndservice)
allow { mediacodec hal_camera_default } pq_vndservice:service_manager find;
binder_call({ mediacodec hal_camera_default }, pq)
