# ueventd rules for the Meizu MX6 (m95), MT6797.
#
# The two `subsystem` blocks below are required: for a subsystem without a
# rule ueventd ignores DEVNAME and creates "/dev/" + basename(devpath), so
# /dev/graphics/fb0 and /dev/input/* would never appear (black screen, no
# touch). Never pre-place a symlink where ueventd should create a node.
subsystem graphics
	devname uevent_devname
	dirname /dev/graphics

subsystem input
	devname uevent_devname

subsystem adf
	devname uevent_devname

# Partition nodes
/dev/block/mmcblk0                                              0660    root    system
/dev/block/mmcblk0boot0                                         0660    root    system
/dev/block/mmcblk0boot1                                         0660    root    system
/dev/misc-sd                                                    0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot      0640    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery  0640    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/seccfg    0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/proinfo   0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram     0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/para      0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/logo      0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp       0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1img    0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1dsp    0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1arm7   0660    root    system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md3img    0660    root    system

# OTP
/dev/otp                  0660   system     system

# SPM (sleep power manager); opened by spm_loader.
/dev/spm                  0660   system     system

# Connectivity (MTK WMT combo chip)
# Owner root: wmt_loader runs as root and must not need dac_override to open
# these nodes; wmt_launcher (system) gets in by group. Do not change to
# system:system, or Wi-Fi and Bluetooth fail under enforcing.
/dev/stpwmt               0660   root       system
/dev/wmtdetect            0660   root       system
# net_bt_stack has no name in bionic, so ueventd would drop the rule; use the
# bluetooth group.
/dev/stpbt                0660   bluetooth  bluetooth
/dev/stpgps               0660   gps        gps
/dev/gps                  0660   gps        system
/dev/stpant               0660   system     system
# Driver state is written by the Wi-Fi HAL (uid wifi); keep group system for
# the legacy writers.
/dev/wmtWifi              0660   wifi       system
/dev/fm                   0660   media      media
/dev/btif                 0600   system     system

# Modem
/dev/ccci*                0660   radio      radio
/dev/ttyC*                0660   radio      radio
/sys/kernel/ccci          modem_info   0644   radio       radio
/sys/kernel/ccci          md1_postfix  0644   radio       radio
/dev/eemcs*               0660   radio      radio
/dev/emd*                 0660   radio      radio
/dev/ccci_pcm_rx          0660   audio      audio
/dev/ccci_pcm_tx          0660   audio      audio
/dev/ccci_aud             0660   audio      audio
/dev/ccci3_aud            0660   audio      audio
/dev/ttyACM0              0660   radio      radio
/dev/ttyUSB0              0660   radio      radio
/dev/ttyUSB1              0660   radio      radio

# GPIO
/dev/mtgpio               0600   radio      root

# Display / graphics
/dev/graphics/*           0660   system     graphics
/dev/fb0                  0660   system     graphics
/dev/mtk_disp_mgr         0660   system     graphics
/dev/mtkfb_vsync          0660   system     graphics
# GCE command queue, used by MDP from the composer (system), the OMX codec
# service and the camera provider (both in group camera). The kernel creates
# the node 0600 root:root.
/dev/mtk_cmdq             0660   system     camera
/dev/sw_sync              0660   system     graphics
/dev/mtk_disp             0444   system     graphics
/dev/ion                  0666   system     graphics
# Mali GPU (MT6797 = Mali-T880)
/dev/mali                 0666   system     graphics
/dev/mali0                0666   system     graphics

# Media / camera
/dev/MTK_SMI              0660   system     camera
# /dev/Vcodec: the MTK OMX blobs open it from media.codec (uid mediacodec,
# gid camera), not from group media as on stock Nougat.
/dev/Vcodec               0660   system     camera
/dev/camera-sysram        0660   system     camera
/dev/camera-isp           0660   system     camera
/dev/camera-fdvt          0660   system     camera
/dev/camera-pipemgr       0660   system     camera
/dev/kd_camera_hw         0660   system     camera
/dev/kd_camera_flashlight 0660   system     camera
/dev/CAM_CAL_DRV          0660   system     camera
# hal3a/iopipe blobs open camera-dpe directly.
/dev/camera-dpe           0660   system     camera
/dev/kd_camera_hw_bus2    0660   system     camera
# Lens actuators, opened by libcam.hal3a.v3.so.
/dev/MAINAF               0660   system     camera
/dev/SUBAF                0660   system     camera
# /dev/devmap: read-only devinfo (efuse) node used by the camera HAL,
# mediacodec and ccci_mdinit. The default 0600 root:root breaks the camera.
/dev/devmap               0440   system     camera

# IR blaster (consumerir.mt6797 blob exists)
/dev/irtx                 0660   system     system

# Touch / hotknot
/dev/touch                0660   root       system
/dev/hotknot              0660   root       system

# Fingerprint (m95 has an mTouch fingerprint home key)
/dev/goodix_fp            0660   system     system
/dev/goodix_fp_spi        0660   system     system

# hang_detect
/dev/RT_Monitor           0600   system     system
/dev/kick_powerkey        0600   system     system

# Backlight trigger attrs (mt65xx_leds)
/sys/devices/platform/leds-mt65xx/leds/lcd-backlight    brightness  0664  system  system

# mx-led: home button breathing/notification LED. lights.mt6797.so (system)
# writes brightness/trigger/delay_on/delay_off.
/sys/devices/platform/leds-mt65xx/leds/mx-led    brightness  0664  system  system
/sys/devices/platform/leds-mt65xx/leds/mx-led    trigger     0664  system  system
/sys/devices/platform/leds-mt65xx/leds/mx-led    delay_on    0664  system  system
/sys/devices/platform/leds-mt65xx/leds/mx-led    delay_off   0664  system  system

# Motion sensors: ST LSM6DS3 (accel/gyro/step/tilt over IIO) with an AK09911
# compass behind its sensor hub. sensors.lsm6ds3.so runs as system and writes
# the scale, sampling-frequency and scan_elements attrs; the kernel creates
# them root-only. From the stock ueventd.rc.
/dev/iio:device*          0660   system     system
/sys/devices/iio:device* buffer/enable 0660 system system
/sys/devices/iio:device* buffer/length 0660 system system
/sys/devices/iio:device* flush 0660 system system
/sys/devices/iio:device* self_test 0660 system system
/sys/devices/iio:device* sampling_frequency 0660 system system
/sys/devices/iio:device* scan_elements/in_timestamp_en 0660 system system
/sys/devices/iio:device* scan_elements/in_accel_x_en 0660 system system
/sys/devices/iio:device* scan_elements/in_accel_y_en 0660 system system
/sys/devices/iio:device* scan_elements/in_accel_z_en 0660 system system
/sys/devices/iio:device* in_accel_x_scale 0660 system system
/sys/devices/iio:device* in_accel_y_scale 0660 system system
/sys/devices/iio:device* in_accel_z_scale 0660 system system
/sys/devices/iio:device* sensor_phone_calling 0660 system system
/sys/devices/iio:device* scan_elements/in_magn_x_en 0660 system system
/sys/devices/iio:device* scan_elements/in_magn_y_en 0660 system system
/sys/devices/iio:device* scan_elements/in_magn_z_en 0660 system system
/sys/devices/iio:device* in_magn_x_scale 0660 system system
/sys/devices/iio:device* in_magn_y_scale 0660 system system
/sys/devices/iio:device* in_magn_z_scale 0660 system system
/sys/devices/iio:device* scan_elements/in_anglvel_x_en 0660 system system
/sys/devices/iio:device* scan_elements/in_anglvel_y_en 0660 system system
/sys/devices/iio:device* scan_elements/in_anglvel_z_en 0660 system system
/sys/devices/iio:device* in_anglvel_x_scale 0660 system system
/sys/devices/iio:device* in_anglvel_y_scale 0660 system system
/sys/devices/iio:device* in_anglvel_z_scale 0660 system system
/sys/devices/iio:device* max_delivery_rate 0660 system system
/sys/devices/iio:device* reset_counter 0660 system system
/sys/devices/iio:device* scan_elements/in_step_counter_en 0660 system system
/sys/devices/iio:device* scan_elements/in_sign_motion_en 0660 system system
/sys/devices/iio:device* scan_elements/in_step_detector_en 0660 system system
/sys/devices/iio:device* scan_elements/in_tilt_en 0660 system system

# Light / proximity: BH1745 ALS at i2c 1-0038 (not the apds9922 the sub-HAL
# advertises) and apds9922 proximity at i2c 1-0053. The alsps sub-HAL writes
# these attrs through /sys/class/meizu; the kernel creates them root-only.
# No barometer on this device.
/sys/devices/* als_data         0660   system     system
/sys/devices/* als_enable      0660   system     system
/sys/devices/* als_batch       0660   system     system
/sys/devices/* ps_data          0660   system     system
/sys/devices/* ps_enable        0660   system     system
/sys/devices/* ps_calibbias     0440   system     system
/sys/devices/* ps_calibration   0660   system     system
/sys/devices/* ps_irq_gpio      0440   system     system
/sys/devices/* ps_offset        0660   system     system
/sys/devices/* ps_threshold     0660   system     system
/sys/devices/* ps_wakeup_enable 0660   system     system
/sys/devices/* ps_non_wakeup_enable 0660 system   system
