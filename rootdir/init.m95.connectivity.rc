# MTK WMT combo chip (Wi-Fi/BT/GPS/FM on the MT6797 CONSYS) and GPS daemons.
# Device node permissions are set in ueventd.mt6797.rc.

on post-fs-data
    # wpa_supplicant control sockets
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

    # BT/FM/GPS shared UART
    chmod 0660 /dev/ttyMT2
    chown system system /dev/ttyMT2

    # GPS power control
    chown gps gps /sys/class/gpsdrv/gps/pwrctl
    chown gps gps /sys/class/gpsdrv/gps/suspend
    chown gps gps /sys/class/gpsdrv/gps/state
    chown gps gps /sys/class/gpsdrv/gps/pwrsave
    chown gps gps /sys/class/gpsdrv/gps/status

    # mnld/agpsd data and socket directories
    mkdir /data/gps_mnl 0771 gps system
    mkdir /data/misc/gps 0770 gps system
    mkdir /data/agps_supl 0771 gps system
    mkdir /data/mpe_mnl 0771 gps system

    # The BT_Addr NVRAM record is regrouped on service.nvram_init=Ready below,
    # so the Bluetooth HAL can read its address.

# WMT: wmt_loader probes the combo chip and exits; wmt_launcher stays resident
# and loads the firmware patches.
service wmt_loader /vendor/bin/wmt_loader
    class core
    user root
    group root
    oneshot

service wmt_launcher /vendor/bin/wmt_launcher -p /vendor/firmware/
    class core
    user system
    group system

# GPS
service mnld /vendor/bin/mnld
    class main
    user gps
    group gps inet misc sdcard_rw sdcard_r media_rw system radio
    socket mnld stream 660 gps system

# AGPS/SUPL
service agpsd /vendor/bin/mtk_agpsd
    class main
    socket agpsd stream 660 gps system
    socket agpsd2 stream 660 gps inet
    socket agpsd3 stream 660 gps inet
    user gps
    group gps radio inet sdcard_r sdcard_rw misc system

# Bluetooth address: the HAL needs it in a property; the factory address is
# in NVRAM (see m95-bdaddr.sh).
service m95_bdaddr /vendor/bin/sh /vendor/bin/m95-bdaddr.sh
    # The shared vendor shell cannot transition per script, so set the domain.
    seclabel u:r:m95_bdaddr:s0
    class core
    user root
    group root bluetooth
    oneshot
    disabled

# nvram_daemon restores the NVRAM records only after post-fs-data; wait for
# its Ready flag before reading BT_Addr.
on property:service.nvram_init=Ready
    chown root bluetooth /data/nvram/APCFG/APRDEB/BT_Addr
    chmod 0660 /data/nvram/APCFG/APRDEB/BT_Addr
    start m95_bdaddr

# wpa_supplicant: external/wpa_supplicant_8 ships no init script.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    group system wifi inet
    disabled
    oneshot
