# /dev/socket/rild-oem: modem OEM control socket, used by the thermal daemon.
# Not rild_socket, which the phone app can reach.
type rild_oem_socket, file_type;

# /dev/socket/rild-ims: MTK IMS command socket
type rild_ims_socket, file_type;

# /dev/socket/rild-mal: RIL socket used by MAL (libmal_rilproxy)
type rild_mal_socket, file_type;

# /dev/socket/wod_{action,sim,ipsec}: ePDG daemon sockets, used by mtkmal
type epdg_wod_socket, file_type;

# /data/ipsec: ePDG daemon working directory
type epdg_wod_data_file, file_type, data_file_type, core_data_file_type;

# MTK procfs

# /proc/ged: MTK GPU extension device, used by every GLES client
type proc_ged, fs_type, proc_type;

# /proc/mtk_cmdq: MDP/display command queue
type proc_cmdq, fs_type, proc_type;

# /proc/driver/thermal: MTK thermal driver
type proc_mtk_thermal, fs_type, proc_type;

# mtkmal sockets: mal-mfi, volte_imsm and their -dongle twins (init.mal.rc)
type mtkmal_socket, file_type;

# /proc/hps: MTK hotplug governor
type proc_hps, fs_type, proc_type;

# VoLTE daemon sockets; volte_imcb's channels share one type.
type volte_stack_socket, file_type;
type volte_ua_socket, file_type;
type volte_imcb_socket, file_type;

# /data/ccci_cfg: modem config store
type ccci_cfg_file, file_type, data_file_type, core_data_file_type;

# /proc/last_kmsg
type m95_proc_last_kmsg, fs_type, proc_type;

# /proc/sys/vm/swappiness
type m95_proc_swappiness, fs_type, proc_type;

# /sys/kernel/debug/ged/hal/custom_boost_gpu_freq: GPU frequency floor
type m95_debugfs_ged_boost, fs_type, debugfs_type;

# Performance tuning procfs (m95-perfprofile.sh)
# /proc/ppm: PPM power state
type m95_proc_ppm, fs_type, proc_type;
# /proc/cpufreq: cpufreq_power_mode
type m95_proc_cpufreq, fs_type, proc_type;
# /proc/perfmgr: touch boost
type m95_proc_perfmgr, fs_type, proc_type;
# /proc/mtkcooler: thermal cooler conditions
type m95_proc_mtkcooler, fs_type, proc_type;

# /proc/sys/debug/exception-trace
type proc_m95_exception_trace, fs_type, proc_type;
