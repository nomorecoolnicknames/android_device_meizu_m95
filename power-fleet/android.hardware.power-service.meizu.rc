service vendor.power-meizu /vendor/bin/hw/android.hardware.power-service.meizu
    class hal
    user system
    group system

# Ownership of the nodes the device's fleet_power.json writes lives in the
# device tree's rc (the nodes differ per kernel); /proc/ppm and /proc/hps are
# root 0644/0664 and the cpufreq floors appear late on the M3 Note (ueventd).
