# MT6797 modem: md1 (GSM/WCDMA/LTE) and md3 (C2K) over CCCI.
# Service names are load-bearing: the daemons start each other by name via
# ctl.start (ccci_mdinit -> ccci_fsd, gsm0710muxd; gsm0710muxd -> ril-daemon-mtk).

on post-fs-data
    # gsm0710muxd symlinks its PTYs to /dev/radio/ptty*
    mkdir /dev/radio 0770 radio radio

    # Modem NV and config directories
    mkdir /data/nvram/md 0770 root system
    mkdir /data/nvram/md3 0770 root system
    mkdir /data/md3 0770 root system
    mkdir /data/ccci_cfg 0770 system radio
    restorecon_recursive /data/ccci_cfg
    chown radio radio /sys/kernel/ccci/boot

# CCCI modem filesystem servers and modem image loaders

# md1
service ccci_fsd /vendor/bin/ccci_fsd 0
    class core
    user radio
    group radio system
    oneshot

service ccci_mdinit /vendor/bin/ccci_mdinit 0
    class core
    user system
    group radio system
    oneshot

# md3 (C2K)
service ccci3_fsd /vendor/bin/ccci_fsd 2
    class core
    user radio
    group radio system
    oneshot

service ccci3_mdinit /vendor/bin/ccci_mdinit 2
    class core
    user system
    group radio system
    oneshot

# 07.10 MUX daemons, started by ccci_mdinit

service gsm0710muxd /vendor/bin/gsm0710muxd -s /dev/ttyC0 -f 512 -n 8 -m basic
    class core
    user root
    group radio cache inet misc
    disabled
    oneshot

# md2 does not exist on MT6797; defined disabled because ccci_mdinit
# references the name.
service gsm0710muxdmd2 /vendor/bin/gsm0710muxdmd2 -s /dev/ccci2_tty0 -f 512 -n 8 -m basic
    class core
    user root
    group radio cache inet misc
    disabled
    oneshot

# RIL daemons

# Started by gsm0710muxd once the MUX channels are up. This is the AOSP rild
# hosting mtk-ril.so; the library is passed with -l and its arguments come
# from vendor.rild.libargs.
service ril-daemon-mtk /vendor/bin/hw/rild -l mtk-ril.so
    class core
    socket mrild stream 660 root radio
    socket mrild2 stream 660 root radio
    socket mrild3 stream 660 root radio
    socket mrild4 stream 660 root radio
    # No seclabel: init would have to create the socket with that type.
    # file_contexts labels the node instead.
    socket rild-ims stream 660 root radio
    socket rild-debug stream 660 radio system
    socket rild-oem stream 660 radio system
    socket rild-mtk-ut stream 660 radio net_bt
    socket rild-mtk-ut-2 stream 660 radio net_bt
    socket rild-mtk-modem stream 660 radio system
    socket rild-atci stream 660 root radio
    socket rild-mal stream 660 radio system
    socket rild-mal-at stream 660 radio system
    socket rild-vsim stream 660 root radio
    socket rild-mbim stream 660 root radio
    socket msap_uim_socket1 stream 660 radio radio
    socket msap_uim_socket2 stream 660 radio radio
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    # Not oneshot, so rild is restarted if it crashes.

# md2 RIL, defined disabled like gsm0710muxdmd2
service ril-daemon-mtkmd2 /vendor/bin/mtkrildmd2
    class core
    socket rild-md2 stream 660 root radio
    socket rild2-md2 stream 660 root radio
    socket rild-debug-md2 stream 660 radio system
    socket rild-oem-md2 stream 660 radio system
    socket rild-mtk-ut-md2 stream 660 radio net_bt
    socket rild-mtk-ut-2-md2 stream 660 radio net_bt
    socket rild-mtk-modem-md2 stream 660 radio system
    socket rild-atci-md2 stream 660 root radio
    socket rild-vsim-md2 stream 660 root radio
    socket rild-mal-md2 stream 660 radio system
    socket rild-mbim-md2 stream 660 root radio
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    oneshot

# GSM/C2K request router
service ril-proxy /vendor/bin/rilproxy -l mtk-rilproxy.so
    class core
    socket rild stream 660 root radio
    socket rild2 stream 660 root radio
    socket rild3 stream 660 root radio
    socket rild4 stream 660 root radio
    socket rilproxy-atci stream 660 root radio
    socket rilproxy-mal stream 660 radio system
    socket sap_uim_socket1 stream 660 bluetooth bluetooth
    socket sap_uim_socket2 stream 660 bluetooth bluetooth
    socket sap_uim_socket3 stream 660 bluetooth bluetooth
    socket sap_uim_socket4 stream 660 bluetooth bluetooth
    socket embmsd stream 660 radio inet
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    oneshot

# ril-proxy is not started: it bridges sockets to mtkrild, which is not used.
# Start it on ril.rilproxy=1 only if BT SIM Access Profile is needed.

# C2K RIL
service viarild /vendor/bin/viarild -l /vendor/lib/libviatelecom-withuim-ril.so -- -d /dev/ttySDIO4
    class core
    socket rild-via stream 660 radio radio
    socket msap_c2k_socket1 stream 660 radio radio
    socket msap_c2k_socket2 stream 660 radio radio
    socket msap_c2k_socket3 stream 660 radio radio
    socket msap_c2k_socket4 stream 660 radio radio
    socket rpc stream 660 radio system
    socket rild-ctclient stream 660 radio system
    socket rild-atci-c2k stream 660 radio system
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    oneshot

# The stock viarild rild-debug socket is dropped: it collides with
# ril-daemon-mtk's.

# Telephony early read
service terservice /vendor/bin/terservice
    class core
    user radio
    group radio cache inet misc
    oneshot

# AOSP rild

# Overrides the AOSP rild.rc. class_restart main still starts it, but without
# -l or vendor.rild.libpath it loads no library.
service vendor.ril-daemon /vendor/bin/hw/rild
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock
    disabled
    oneshot

# Modem loggers, disabled; start manually when debugging.

service mdlogger /vendor/bin/mdlogger
    class main
    user shell
    group shell system radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot

service emdlogger1 /vendor/bin/emdlogger1
    class main
    user shell
    group system shell radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot

service emdlogger2 /vendor/bin/emdlogger2
    class main
    user shell
    group system shell radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot

service emdlogger3 /vendor/bin/emdlogger3
    class main
    user shell
    group system shell radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot

service emdlogger5 /vendor/bin/emdlogger5
    class main
    user shell
    group system shell radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot
